eft:16%;top:23%;background:#b9d8eb;border:10px solid #fff;box-shadow:inset 0 0 0 3px #6e7b83}.room-window:before{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:3px solid #fff}.room-door{position:absolute;width:85px;height:190px;right:14%;bottom:35%;background:#9a6b42;border:7px solid #6e4b30}.room-sofa{position:absolute;left:30%;bottom:35%;width:180px;height:55px;background:#8d969b;border-radius:8px 8px 4px 4px}.room-sofa:before{content:"";position:absolute;left:10px;right:10px;top:-45px;height:48px;background:#9ca6ab;border-radius:12px 12px 3px 3px}.room-label{position:absolute;top:12px;left:12px;background:#17202acc;color:#fff;padding:7px 10px;font-size:11px;font-weight:700}.calc-result{background:var(--navy);color:#fff;padding:18px;margin-top:12px}.calc-result strong{font-family:Oswald;font-size:28px}.mini-note{font-size:12px;color:var(--muted);line-height:1.5}.paint-product-result{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--line);padding-top:12px;margin-top:12px}.paint-product-result button{border:0;background:var(--orange);color:#fff;padding:10px 14px;font-weight:700;cursor:pointer}
